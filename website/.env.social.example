# OAT Social AI Instagram Login integration
# Add these to the Vercel project environment. Never use NEXT_PUBLIC_ for secrets.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/social/instagram/callback
SOCIAL_META_TOKEN_ENCRYPTION_KEY=
SOCIAL_SUPABASE_SERVICE_ROLE_KEY=
# Alternative if your Supabase project uses the newer secret key format:
# SOCIAL_SUPABASE_SECRET_KEY=
