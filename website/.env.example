# OWN / OATHome LLM — server-side configuration
# Never commit real secrets or expose them through NEXT_PUBLIC_* variables.

# Inference server reachable from the Next.js server.
# Leave blank for local development; defaults to http://127.0.0.1:11434.
# In production, use a private/protected URL reachable from your hosting provider.
OATHOME_LLM_BASE_URL=

# Required in production to unlock OWN chat. Use a long random secret.
OATHOME_LLM_ACCESS_TOKEN=

# Optional separate bearer credential if the upstream inference service requires auth.
OATHOME_LLM_UPSTREAM_TOKEN=

# Optional installed model selected by default.
OATHOME_LLM_MODEL=

# Supabase server-side connection. Use the project URL and a secret key
# (preferred: sb_secret_...); legacy service_role keys are also supported.
# Never prefix the secret key with NEXT_PUBLIC_ and never commit its value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
