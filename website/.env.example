# OAT Social AI — Cloudflare Workers AI (server-side only)
# Add these to the OAT Social AI Vercel project. Never use NEXT_PUBLIC_ for secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# OWN / OATHome LLM — separate runtime configuration (not used by OAT Social AI)
OATHOME_LLM_BASE_URL=
OATHOME_LLM_MODEL=qwen2.5:3b
OATHOME_LLM_ACCESS_TOKEN=
OATHOME_LLM_UPSTREAM_TOKEN=

# Optional self-hosted speech services. Leave blank until deployed.
OATHOME_STT_BASE_URL=
OATHOME_STT_TOKEN=
OATHOME_TTS_BASE_URL=
OATHOME_TTS_TOKEN=

# Supabase server-side connection. Never expose this key through NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OAT Social AI browser authentication (Supabase Auth).
NEXT_PUBLIC_SOCIAL_SUPABASE_URL=
NEXT_PUBLIC_SOCIAL_SUPABASE_ANON_KEY=

# OAT Social AI - Composio managed Instagram OAuth (server-only).
COMPOSIO_API_KEY=
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
