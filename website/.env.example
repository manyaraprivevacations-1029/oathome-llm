# AI Bot environment
# Keep secrets server-side. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AI_BOT_WORKSPACE_ID=

# CRM integration
CRM_API_URL=

# Telephony (separate from LLM inference)
VOICE_PROVIDER=vapi
VAPI_PRIVATE_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VOICE_FROM_NUMBER=
VOICE_WEBHOOK_BASE_URL=
VAPI_WEBHOOK_SECRET=
INBOUND_AI_EMPLOYEE_ID=ananya

# OATHome LLM runtime
# Local development defaults to http://127.0.0.1:11434 when NODE_ENV is not production.
# In Vercel/production, point this at your protected OATHome inference server.
OATHOME_LLM_BASE_URL=
# Required for production chat requests; use a long random value and keep it server-side.
OATHOME_LLM_ACCESS_TOKEN=
# Optional default model for scripts or future integrations.
OATHOME_LLM_MODEL=
